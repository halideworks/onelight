{
  "name": "onelight",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "author": "David Torcivia (halideworks)",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @onelight/server dev",
    "lint": "pnpm typecheck && eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/core packages/db packages/worker packages/player packages/api packages/job-protocol apps/server apps/cf apps/worker && tsc -p qa/tsconfig.json",
    "integration:e2e": "node scripts/integration-e2e.mjs",
    "qa": "pnpm --filter @onelight/qa test",
    "qa:fixtures": "pnpm --filter @onelight/qa fixtures",
    "web:check": "pnpm --filter @onelight/web --filter @onelight/player check",
    "openapi:gen": "tsx packages/api/src/generate-openapi.ts",
    "openapi:check": "tsx packages/api/src/generate-openapi.ts --check",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:check": "tsx packages/db/src/check-schema.ts",
    "config:gen": "tsx scripts/gen-config.ts",
    "config:check": "tsx scripts/gen-config.ts --check && tsx scripts/check-config-parity.ts",
    "seed": "tsx apps/server/src/seed.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.7",
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.113.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@5": "5.0.9",
      "cookie": "0.7.2",
      "devalue@5": "5.9.4",
      "esbuild": "0.25.12",
      "js-yaml": "4.3.2",
      "nanoid@3": "3.3.19",
      "postcss@8": "8.5.28",
      "sharp": "0.35.4",
      "undici@7": "7.29.0",
      "ws": "8.21.0"
    }
  }
}
